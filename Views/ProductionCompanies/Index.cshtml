@model PaginatedList<Zaliczenie.Models.ProductionCompany>

<h1>Lista Wytwórni</h1>

<form asp-action="Index" method="get" class="mb-4">
    <div class="input-group">
        <input type="text" name="searchTerm" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Wyszukaj nazwę..." />
        <button type="submit" class="btn btn-success">Wyszukaj</button>
    </div>
</form>

<table class="table table-striped table-dark">
    <thead class="table-dark">
    <tr>
        <th>
            <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParameter"]" asp-route-currentFilter="@ViewData["CurrentFilter"]">
                Nazwa Wytwórni
            </a>
        </th>
        <th>Ilość Filmy</th>
        <th>Budżet</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var studio in Model)
    {
        var filmCount = studio.MovieProductionCompanies?.Count ?? 0;
        var totalBudget = studio.MovieProductionCompanies?
            .Sum(mpc => mpc.Movie.Budget ?? 0) ?? 0;
        var filmSuffix = filmCount == 1 ? "" : (filmCount >= 2 && filmCount <= 4 ? "y" : "ów");
        var filmName = "film" + filmSuffix;
        <tr>
            <td>@studio.CompanyName</td>
            <td>
                <a asp-action="Movies" asp-route-id="@studio.CompanyId" class="text-decoration-none">
                    @filmCount @filmName
                </a>
            </td>
            <td>@totalBudget.ToString("C0")</td>
        </tr>
    }
    </tbody>
</table>

@{
    var previousDisabled = !Model.HasPreviousPage ? "disabled" : "";
    var nextDisabled = !Model.HasNextPage ? "disabled" : "";
    var maxPageButtons = 5;
    var startPage = Math.Max(1, Model.PageIndex - 2);
    var endPage = Math.Min(Model.TotalPages, startPage + maxPageButtons - 1);
    startPage = Math.Max(1, endPage - maxPageButtons + 1);
}

<nav aria-label="Pagination">
    <ul class="pagination justify-content-center">
        <li class="page-item @previousDisabled">
            <a class="page-link bg-dark text-light @previousDisabled"
               asp-action="Index"
               asp-route-pageNumber="@(Model.PageIndex - 1)"
               asp-route-currentFilter="@ViewData["CurrentFilter"]"
               asp-route-sortOrder="@ViewData["CurrentSort"]">
                Poprzednia
            </a>
        </li>

        @if (startPage > 1)
        {
            <li class="page-item">
                <a class="page-link bg-dark text-light" asp-action="Index"
                   asp-route-pageNumber="1"
                   asp-route-currentFilter="@ViewData["CurrentFilter"]"
                   asp-route-sortOrder="@ViewData["CurrentSort"]">1</a>
            </li>
            if (startPage > 2)
            {
                <li class="page-item disabled">
                    <span class="page-link">...</span>
                </li>
            }
        }

        @for (var i = startPage; i <= endPage; i++)
        {
            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-pageNumber="@i"
                   asp-route-currentFilter="@ViewData["CurrentFilter"]"
                   asp-route-sortOrder="@ViewData["CurrentSort"]">
                    @i
                </a>
            </li>
        }

        @if (endPage < Model.TotalPages)
        {
            if (endPage < Model.TotalPages - 1)
            {
                <li class="page-item disabled">
                    <span class="page-link bg-dark text-muted">...</span>
                </li>
            }
            <li class="page-item">
                <a class="page-link bg-dark text-light" asp-action="Index"
                   asp-route-pageNumber="@Model.TotalPages"
                   asp-route-currentFilter="@ViewData["CurrentFilter"]"
                   asp-route-sortOrder="@ViewData["CurrentSort"]">@Model.TotalPages</a>
            </li>
        }

        <li class="page-item @nextDisabled">
            <a class="page-link bg-dark text-light @nextDisabled"
               asp-action="Index"
               asp-route-pageNumber="@(Model.PageIndex + 1)"
               asp-route-currentFilter="@ViewData["CurrentFilter"]"
               asp-route-sortOrder="@ViewData["CurrentSort"]">
                Następna
            </a>
        </li>
    </ul>
</nav>

<div class="text-center mt-4">
    <p>
        Strona @Model.PageIndex z @Model.TotalPages (Łączna liczba: @Model.TotalItems)
    </p>
</div>
<style>
    body {
        background-color: #212529;
        color: #fff;
    }
    .table-dark th {
        color: #fff;
    }
    .pagination .page-link {
        border: none;
    }
</style>
